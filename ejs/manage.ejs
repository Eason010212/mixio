    <script>
        var clearMessage = function(userName){
            $.get('clearMessage',{
                "userName":userName
            },function(res){
                if(res == 1)
                {
                    showtext(i18n('actionSuccess'))
                    setTimeout(function(){
                        window.location.href = window.location.href.split("?")[0] + "?page=user"
                    },1000)
                }
                else
                {
                    showtext(i18n('actionFailed'))
                }
            })
        }
        var resetPassword = function(userName){
            if (!confirm(i18n('resetUserPasswordConfirm', { user: userName }))) {
                return;
            }
            const modald = showmodaltext("<div style='text-align:center'><i class='fa fa-spin fa-cog' style='font-size:2rem;color:#4e73df'></i><p style='margin-top:6px;margin-bottom:0;color:#4e73df;font-size:1rem;font-weight:bold'>" + i18n('resettingPassword') + "</p></div>");
            $.get('resetf',{
                "username":userName,
                "password":"123456"
            },function(res){
                if(res == 1)
                {
                    modald.close()
                    showtext(i18n('actionSuccess'))
                    setTimeout(function(){
                        window.location.href = window.location.href.split("?")[0] + "?page=user"
                    },1000)
                }
                else
                {
                    modald.close()
                    showtext(i18n('actionFailed'))
                }
            })
        }
        var removeUser = function(userName){
            if (!confirm(i18n('deleteUserConfirm', { user: userName }))) {
                return;
            }
            const modald = showmodaltext("<div style='text-align:center'><i class='fa fa-spin fa-cog' style='font-size:2rem;color:#4e73df'></i><p style='margin-top:6px;margin-bottom:0;color:#4e73df;font-size:1rem;font-weight:bold'>" + i18n('processing') + "</p></div>");
            $.get('deletef',{
                "username":userName
            },function(res){
                if(res == 1)
                {
                    modald.close()
                    showtext(i18n('actionSuccess'))
                    setTimeout(function(){
                        window.location.href = window.location.href.split("?")[0] + "?page=user"
                    },1000)
                }
                else
                {
                    modald.close()
                    showtext(i18n('actionFailed'))
                }
            })
        }
        $("#time").html(new Date().toLocaleTimeString())
        setInterval(() => {
            $("#time").html(new Date().toLocaleTimeString())
        }, 1000);
        var configs = <%-configs%>
        $("#OFFLINE_MODE").bind('change',function(){
            if($("#OFFLINE_MODE").prop("checked"))
            {
                $("#BAIDU_MAP_AK").attr("disabled","true")
                $("#BAIDU_MAP_SERVER_AK").attr("disabled","true")
            }
            else
            {
                $("#BAIDU_MAP_AK").removeAttr("disabled")
                $("#BAIDU_MAP_SERVER_AK").removeAttr("disabled")
            }
        })
        var loadConfig = function(){
            var mapping = {
                "MIXIO_HTTP_PORT": i18n('configHttpPort'),
                "MIXIO_HTTPS_PORT": i18n('configHttpsPort'),
                "HTTPS_PRIVATE_PEM": i18n('configPrivateKey'),
                "HTTPS_CRT_FILE": i18n('configCertificate'),
                "MIXIO_MQTT_PORT": i18n('configMqttPort'),
                "MIXIO_WS_PORT": i18n('configMqttWsPort'),
                "MIXIO_WSS_PORT": i18n('configMqttWssPort'),
                "MIXIO_YJS_PORT": i18n('configYjsWsPort'),
                "MIXIO_YJS_WSS_PORT": i18n('configYjsWssPort'),
                "MAX_PROJECT_NUM_PER_USER": i18n('configMaxProjects'),
                "MAX_MESSAGE_PER_USER": i18n('configMaxOfflineMessages'),
                "MAX_MESSAGE_PER_SECOND": i18n('configMaxMessagesPerSecond'),
                "ALLOW_REGISTER": i18n('configAllowRegister'),
                "ALLOW_HOOK": i18n('configAllowOfflineStorage'),
                "OFFLINE_MODE": i18n('configOfflineMode'),
                "BAIDU_MAP_AK": i18n('configBaiduClientAk'),
                "BAIDU_MAP_SERVER_AK": i18n('configBaiduServerAk'),
                "TENCENT_MAP_KEY": i18n('configTencentKey'),
                "BAIDU_STAT_LINK": i18n('configAnalyticsLink'),
                "ADMIN_USERNAME": i18n('configAdminUser'),
                "ADMIN_PASSWORD": i18n('configAdminPassword'),
                "STORAGE_ENGINE": i18n('configStorageEngine'),
                "MYSQL_HOST": i18n('configMysqlHost'),
                "MYSQL_PORT": i18n('configMysqlPort'),
                "MYSQL_USER": i18n('configMysqlUser'),
                "MYSQL_PASS": i18n('configMysqlPassword'),
                "MYSQL_DB": i18n('configMysqlDatabase'),
                "FOOTER": i18n('configFooter')
            }
            const tbody = document.querySelector('#configTable tbody');
            tbody.innerHTML = '';
            
            for (const [key, value] of Object.entries(configs)) {
                const tr = document.createElement('tr');
                
                // 配置名
                const tdKey = document.createElement('td');
                tdKey.textContent = key;
                const tdName = document.createElement('td');
                tdName.textContent = mapping[key];
                
                // 数据类型
                const tdType = document.createElement('td');
                const type = typeof value;
                const badge = document.createElement('span');
                badge.className = `badge badge-type badge-${type}`;
                badge.textContent = type;
                tdType.appendChild(badge);
                
                // 配置值
                const tdValue = document.createElement('td');
                let inputElement;
                
                if (type === 'boolean') {
                    inputElement = document.createElement('select');
                    inputElement.className = 'form-control';
                    inputElement.innerHTML = `
                        <option value="true" ${value ? 'selected' : ''}>${i18n('yes')} (true)</option>
                        <option value="false" ${!value ? 'selected' : ''}>${i18n('no')} (false)</option>
                    `;
                } else if (type === 'number') {
                    inputElement = document.createElement('input');
                    inputElement.type = 'number';
                    inputElement.className = 'form-control';
                    inputElement.value = value;
                    inputElement.step = Number.isInteger(value) ? '1' : '0.01';
                } else {
                    console.log(key)
                    inputElement = document.createElement('input');
                    inputElement.type = (/PASSWORD|PASS/.test(key) ? 'password' : 'text');
                    inputElement.className = 'form-control';
                    inputElement.value = value;
                }
                inputElement.setAttribute('data-key', key);
                tdValue.appendChild(inputElement);
                tr.appendChild(tdKey);
                tr.appendChild(tdName);
                tr.appendChild(tdType);
                tr.appendChild(tdValue);
                
                tbody.appendChild(tr);
            }

        }
        loadConfig()
        
        
        var saveAndRestart = function(){
            var modald = showmodaltext("<div style='text-align:center'><i class='fa fa-spin fa-cog' style='font-size:2rem;color:#4e73df'></i><p style='margin-top:6px;margin-bottom:0;color:#4e73df;font-size:1rem;font-weight:bold'>"+JSLang[lang].loading2+"</p></div>")
            const inputs = document.querySelectorAll('#configTable input, #configTable select');
            configs = {};
            
            inputs.forEach(input => {
                const key = input.getAttribute('data-key');
                const originalType = input.getAttribute('type');
                
                if (originalType === 'text' || originalType === 'password') {
                    configs[key] = input.value;
                } else if (originalType === 'number') {
                    configs[key] = Number(input.value);
                } else {
                    configs[key] = input.value === 'true'
                }
            });
            console.log(configs)
            // 改为ajax, 超时设置为60s
            $.ajax({
                url: '/saveAndRestart',
                type: 'GET',
                data: {'configs':JSON.stringify(configs,null,2)},
                timeout: 60000,
                success: function(res){
                    if(res=="1")
                    {
                        showtext(i18n('settingsSavedRestarting'))
                    }
                    else
                        showtext(i18n('saveFailed'))
                    modald.close()
                },
                error: function(res){
                    modald.close()
                    showtext(i18n('saveFailed'))
                }
            })
        }
        var stopServer = function(){
            var modald = showmodaltext("<div style='text-align:center'><i class='fa fa-spin fa-cog' style='font-size:2rem;color:#4e73df'></i><p style='margin-top:6px;margin-bottom:0;color:#4e73df;font-size:1rem;font-weight:bold'>"+JSLang[lang].loading2+"</p></div>")
            $.get('/stop',function(res){
                modald.close()
                if(res=="1")
                {
                    window.location.href = window.location.href
                }
                else
                    showtext(i18n('abnormalStatus'))
            })
        }
        var startServer = function(){
            var modald = showmodaltext("<div style='text-align:center'><i class='fa fa-spin fa-cog' style='font-size:2rem;color:#4e73df'></i><p style='margin-top:6px;margin-bottom:0;color:#4e73df;font-size:1rem;font-weight:bold'>"+JSLang[lang].loading2+"</p></div>")
            $.get('/start',function(res){
                modald.close()
                if(res=="1")
                {
                    window.location.href = window.location.href
                }
            })
        }
        
        var fresh = function(product, platform){
            var textarea = $("<textarea readonly cols='50' rows='20' style='color:white; background-color:black'></textarea>")
            var add_text = function(text){
                textarea.text(textarea.text() + text + "\n")
                textarea.scrollTop(textarea[0].scrollHeight);
            }
            var d = dialog({
                content: textarea
            });
            d.showModal();
            add_text(i18n('sendingUpdateRequest'))
            fetch('/api/check-update', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    product: product,
                    platform: platform
                })
            })
            .then((response) => response.json())
            .then((result) => {
                add_text(i18n('localVersion', { version: result["localVersion"] }))
                add_text(i18n('cloudVersion', { version: result["cloudVersion"] }))
                add_text(i18n('updateRequired', { value: result["needsUpdate"] }))
                var url = result["cloudFile"]
                var error = result["error"]
                if(error)
                {
                    add_text(error)
                }
                if(result["cloudVersion"] && result["needsUpdate"])
                {
                    const eventSource = new EventSource(`/api/download?url=${encodeURIComponent(url)}&cloudVersion=${result["cloudVersion"]}`);
                    add_text(i18n('downloadStarted'))
                    eventSource.onmessage = function(event) {
                        console.log(event)
                        const data = JSON.parse(event.data);
                        console.log(data)
                        if (data.type === 'progress') {
                            add_text(i18n('downloadingProgress', { progress: data.progress }))
                        } 
                        else if (data.type === 'unzip') {
                            add_text(i18n('extracting'))
                        } 
                        else if (data.type === 'complete') {
                            eventSource.close();
                            if(data.version == "mixio"){
                                add_text(i18n('extractionCompleteWait', { version: data.version }));
                                setTimeout(
                                    function(){
                                        alert(i18n('updateCompletedRestart'))
                                        window.location.reload()
                                    }
                                , 30000)
                            }
                            else{
                                alert(i18n('updateCompleted'))
                                window.location.reload()
                            }
                        }
                    };
                    eventSource.onerror = function(error) {
                        console.log(error)
                        add_text(i18n('downloadFailedExit'));
                            setTimeout(function(){
                            d.close()
                        }, 5000)
                        eventSource.close();
                    };
                }
                else
                {
                    add_text(i18n('upToDateExit'))
                    setTimeout(function(){
                        d.close()
                    }, 5000)
                }
            })
            .catch((error) => {
                add_text(error);
            });
        }
        var view = function(index){
            a = [1,2,3]
            for (i in a){
                v = a[i]
                if (index==v){
                    $("#detail"+v).removeAttr("hidden")
                    $("#view"+v).addClass("active")
                }
                else
                {
                    $("#detail"+v).attr("hidden","hidden")
                    $("#view"+v).removeClass("active")
                }
            }
        }
        // 尝试获取page参数
        if(window.location.href.split("?").length > 1){
            var page = window.location.href.split("?")[1].split("=")[1]
            if (page == "user")
                view(2)
            else if(page == "basic")
                view(1)
            else if(page == "batch")
                view(3)
        }
        var addAcc = function(){
            var modald = showmodaltext("<div style='text-align:center'><i class='fa fa-spin fa-cog' style='font-size:2rem;color:#4e73df'></i><p style='margin-top:6px;margin-bottom:0;color:#4e73df;font-size:1rem;font-weight:bold'>"+JSLang[lang].loading2+"</p></div>")
            var acc = $("#acc").val()
            accs = acc.split('\n')
            acct = []
            for(acc in accs){
                if(accs[acc]!="")
                    acct.push(accs[acc])
            }
            var successCount = 0
            var failCount = 0
            var failInfo = []
            for(i in acct){
                info = acct[i].split(',')
                if(info.length!=4)
                {
                    failCount+=1
                    failInfo.push({
                        'account':info[0],
                        'reason':i18n('invalidFormat')
                    })
                }
                else
                {
                    $.get('addAccount',{'userName':info[0],'password':info[1],'question':info[2],'answer':info[3]},function(res){
                        modald.close()
                        if(res=='1')
                            successCount+=1
                        else if(res=='2')
                        {
                            failCount+=1
                            failInfo.push({
                                'account':info[0],
                                'reason':i18n('userAlreadyExists')
                            })
                        }
                        else if(res=='3')
                        {
                            failCount+=1
                            failInfo.push({
                                'account':info[0],
                                'reason':i18n('connectionFailed')
                            })
                        }
                        var s = i18n('batchResult', { success: successCount, failed: failCount, reasons: JSON.stringify(failInfo) })
                        showtext(s)
                    })
                }
            }
        }
    </script>
</body>
