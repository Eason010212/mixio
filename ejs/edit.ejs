        function restoreVersion(versionId) {
            if (!confirm('确定要恢复到此版本吗？当前的内容将被覆盖。')) {
                return;
            }

            showLoading();
            $.ajax({
                url: `/api/restoreFileVersion/${creator}/${fileId}`,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ versionId: versionId }),
                dataType: 'json',
                success: function(response) {
                    hideLoading();
                    if (response.success) {
                        showToast('版本恢复成功');
                        // 关闭模态框
                        $('#versionPreviewModal').modal('hide');
                        $('#versionsModal').modal('hide');

                        // 直接更新编辑器内容，不重新加载整个文档
                        if (simplemde) {
                            $.ajax({
                                url: `/api/getFileVersion/${creator}/${fileId}/${versionId}`,
                                type: 'GET',
                                dataType: 'json',
                                success: function(versionResponse) {
                                    if (versionResponse.success) {
                                        const newContent = versionResponse.version.content;
                                        simplemde.value(newContent);

                                        // 更新Yjs内容
                                        if (isYjsReady && ytext) {
                                            ydoc.transact(() => {
                                                ytext.delete(0, ytext.length);
                                                ytext.insert(0, newContent);
                                            });
                                        }

                                        // 重置脏状态
                                        isDirty = false;
                                        updateSaveStatus('saved', '已保存');

                                        // 清空自动保存定时器
                                        if (saveTimer) {
                                            clearTimeout(saveTimer);
                                            saveTimer = null;
                                        }

                                        showToast('内容已更新');
                                    } else {
                                        showToast('获取版本内容失败', true);
                                    }
                                },
                                error: function(xhr, status, error) {
                                    console.error('获取版本内容失败:', error);
                                    showToast('获取版本内容失败', true);
                                }
                            });
                        }
                    } else {
                        showToast(response.message || '恢复版本失败', true);
                    }
                },
                error: function(xhr, status, error) {
                    hideLoading();
                    console.error('恢复版本失败:', error);
                    showToast('恢复版本失败: ' + error, true);
                }
            });
        }

        function deleteVersion(versionId) {
