        // 更新保存状态
        function updateSaveStatus(status, message) {
            const statusEl = $('#saveStatus');
            if (status === 'saving') {
                statusEl.html('<i class="fa fa-spinner fa-spin"></i><span>保存中...</span>');
                statusEl.removeClass('saved error').addClass('saving');
            } else if (status === 'saved') {
                statusEl.html('<i class="fa fa-check-circle"></i><span>' + message + '</span>');
                statusEl.removeClass('saving error').addClass('saved');
            } else if (status === 'error') {
                statusEl.html('<i class="fa fa-exclamation-circle"></i><span>' + message + '</span>');
                statusEl.removeClass('saving saved').addClass('error');
            }
        }
        
        // 保存文档到服务器
        function saveToServer(content) {
            updateSaveStatus('saving', '保存中...');
            
            $.ajax({
                url: `/api/saveDocumentContent/${creator}/${fileId}`,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ content: content }),
                dataType: 'json',
                success: function(response) {
                    if (response.success) {
                        updateSaveStatus('saved', '已保存');
                        isDirty = false;
                        setTimeout(() => {
                            if (!isDirty) {
                                updateSaveStatus('saved', '已保存');
                            }
                        }, 2000);
                    } else {
                        updateSaveStatus('error', response.message || '保存失败');
                        showToast(response.message || '保存失败', true);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('保存失败:', error);
                    updateSaveStatus('error', '保存失败');
                    showToast('保存失败: ' + error, true);
                }
            });
        }
        
        // 自动保存
        function autoSave() {
            if (isDirty && simplemde) {
                const content = simplemde.value();
                saveToServer(content);
            }
        }
        
        // 手动保存
        function manualSave() {
            if (simplemde) {
                const content = simplemde.value();
                saveToServer(content);
            }
        }
        
        // 重命名文件
        function renameFile(newName) {
            if (!newName || newName.trim() === '') {
                showToast('文件名不能为空', true);
                return false;
            }

            // 根据文件类型检查扩展名
            if (currentFile.type === 'document') {
                if (!newName.endsWith('.md') && !newName.endsWith('.txt')) {
                    newName = newName + '.md';
                }
            } else if (currentFile.type === 'spreadsheet') {
                if (!newName.endsWith('.csv')) {
                    newName = newName + '.csv';
                }
            }

            showLoading();
            $.ajax({
                url: `/api/renameFile/${creator}/${fileId}`,
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify({ newName: newName }),
                dataType: 'json',
                success: function(response) {
                    hideLoading();
                    if (response.success) {
                        currentFile.name = response.file.name;
                        $('#fileName').val(currentFile.name);
                        showToast('重命名成功');
                        const typeText = currentFile.type === 'document' ? '文档' : '表格';
                        document.title = `${currentFile.name} - ${typeText}编辑`;
                    } else {
                        showToast(response.message || '重命名失败', true);
                    }
                },
                error: function(xhr, status, error) {
                    hideLoading();
                    console.error('重命名失败:', error);
                    showToast('重命名失败: ' + error, true);
                }
            });
            return true;
        }
        
        // WebSocket连接配置
                const wsConfig = {
                    url: getWebSocketUrl(),
                    roomName: currentFile.type === 'spreadsheet' ? `sheet-${fileId}` : `doc-${fileId}`,
                    reconnectInterval: 3000,
                    maxReconnectAttempts: 5
                };

                let reconnectCount = 0;
                let reconnectTimer = null;

                // 初始化 Yjs 协同编辑（严格按照 demo 的方式）
                function initYjs(initialContent) {
                    try {
                        console.log('初始化 Yjs 协同编辑...');

                        // 创建 Yjs 文档
                        ydoc = new Doc();

                        // 根据文件类型确定房间名称
                        const roomName = wsConfig.roomName;

                        // 连接 WebSocket 服务器
                        provider = new WebsocketProvider(wsConfig.url, roomName, ydoc);

                        // 根据文件类型获取 Y.Text 对象
                        const textName = currentFile.type === 'spreadsheet' ? 'csv-text' : 'markdown-text';
                        ytext = ydoc.getText(textName);

                        // 等待Yjs同步完成后再设置内容
                        provider.on('sync', (synced) => {
                            if (synced) {
                                // 同步完成后，如果Yjs文本为空，从编辑器获取内容设置到Yjs
                                // 避免重复设置内容
                                if (ytext.length === 0 && simplemde) {
                                    const editorContent = simplemde.value();
                                    if (editorContent) {
                                        ydoc.transact(() => {
                                            ytext.insert(0, editorContent);
                                        });
                                    }
                                }
                            }
                        });

                        // Yjs -> 编辑器
                        ytext.observe(() => {
                            if (simplemde && !isEditorUpdating) {
                                const current = simplemde.value();
                                const updated = ytext.toString();
                                if (current !== updated) {
                                    // 使用临时变量避免循环触发
                                    if (!isYjsUpdating) {
                                        isYjsUpdating = true;
                                        simplemde.value(updated);
                                        setTimeout(() => {
                                            isYjsUpdating = false;
                                        }, 10);
                                    }
                                }
                            }
                        });

                        // 编辑器 -> Yjs（根据编辑器类型使用不同的监听方式）
                        if (simplemde && currentFile.type === 'document') {
                            let lastChangeTime = 0;
                            const changeDebounce = 100; // 防抖时间（毫秒）

                            simplemde.codemirror.on('change', () => {
                                // 防止在Yjs更新时触发编辑器变更
                                if (isYjsUpdating) {
                                    return;
                                }

                                const now = Date.now();

                                // 防抖处理
                                if (now - lastChangeTime < changeDebounce) {
                                    return;
                                }
                                lastChangeTime = now;

                                if (isYjsReady && provider) {
                                    const newVal = simplemde.value();
                                    isEditorUpdating = true;
                                    ydoc.transact(() => {
                                        ytext.delete(0, ytext.length);
                                        ytext.insert(0, newVal);
                                    });
                                    isEditorUpdating = false;

                                    // 更新用户光标位置
                                    const cursor = simplemde.codemirror.getCursor();
                                    provider.awareness.setLocalStateField('cursor', cursor);
                                } else {
                                    // 未连接协同模式，标记为本地修改
                                    if (!isDirty) {
                                        isDirty = true;
                                        updateSaveStatus('saving', '未保存');
                                    }
                                    if (saveTimer) clearTimeout(saveTimer);
                                    saveTimer = setTimeout(() => autoSave(), 3000);
                                }
                            });
                        }

                        // 监听连接状态
                        provider.on('status', event => {
                            console.log('Yjs 连接状态:', event.status);
                            updateConnectionStatus(event.status);

                            if (event.status === 'connected') {
                                reconnectCount = 0;
                                isYjsReady = true;
                                $('#collabPanel').show();
                                showToast('协同编辑已连接');
                                // 连接成功后更新用户列表
                                updateCollabUsers();

                                // 注意：不在这里设置内容，避免重复设置
                                // 内容已经在初始化时设置到编辑器和Yjs中
                            } else if (event.status === 'disconnected') {
                                isYjsReady = false;
                                $('#collabPanel').hide();
                                showToast('协同编辑连接断开，将使用本地模式', true);

                                // 尝试重新连接
                                if (reconnectCount < wsConfig.maxReconnectAttempts) {
                                    reconnectTimer = setTimeout(() => {
                                        reconnectCount++;
                                        console.log(`尝试重新连接 (${reconnectCount}/${wsConfig.maxReconnectAttempts})`);
                                        connectWebSocket();
                                    }, wsConfig.reconnectInterval);
                                }
                            }
                        });

                        // 监听同步完成事件，自动展开面板当有协作者时
                        provider.on('sync', (synced) => {
                            if (synced) {
                                const states = provider.awareness.getStates();
                                if (states.size > 1) {
                                    $('#collabPanel').removeClass('collapsed');
                                    showToast('有协作者加入');
                                }
                            }
                        });

                        // 监听协同用户变化
                        provider.awareness.on('change', () => {
                            updateCollabUsers();
                        });

                        // 设置本地用户状态（会触发 change 事件）
                        provider.awareness.setLocalState({
                            user: {
                                id: currentUser,
                                name: currentUser,
                        color: getUserColor(currentUser)
                    },
                    status: 'online'
                });

                // 立即初始化用户列表显示
                setTimeout(() => {
                    updateCollabUsers();
                }, 100);
                
            } catch (error) {
                console.error('Yjs 初始化失败:', error);
                showToast('协同编辑功能不可用，将使用普通模式', true);
                isYjsReady = false;
                
                // 降级模式：启动自动保存
                if (simplemde) {
                    simplemde.codemirror.on('change', () => {
                        if (!isDirty) {
                            isDirty = true;
                            updateSaveStatus('saving', '未保存');
                        }
                        if (saveTimer) clearTimeout(saveTimer);
                        saveTimer = setTimeout(() => autoSave(), 3000);
                    });
                }
            }
        }
        
        // 初始化文档编辑器
        function initDocumentEditor(initialContent) {
            // 初始化 EasyMDE
            simplemde = new EasyMDE({
                element: document.getElementById('editor'),
                spellChecker: false,
                autosave: {
                    enabled: false
                },
                toolbar: [
                    'bold', 'italic', 'heading', '|',
                    'quote', 'code', 'unordered-list', 'ordered-list', '|',
                    'link', 'image',
                    'preview', 'side-by-side', 'fullscreen', '|',
                    'guide'
                ],
                placeholder: '在此编写文档内容...',
                status: ['lines', 'words', 'cursor'],
                renderingConfig: {
                    codeSyntaxHighlighting: true,
                }
            });

            // 只在这里设置初始内容一次，避免重复
            if (initialContent) {
                simplemde.value(initialContent);
            }

            isEditorInitialized = true;
        }

        // 初始化表格编辑器
        function initSpreadsheetEditor(initialContent) {
            // 显示表格工具栏
            $('#spreadsheetToolbar').show();

            const editorElement = document.getElementById('editor');

            // 将textarea转换为div，用于handsontable
            const container = document.createElement('div');
            container.id = 'editor';
            container.style.height = 'calc(100vh - 140px)';
            container.style.width = '100%';

            // 替换textarea为div
            editorElement.parentNode.replaceChild(container, editorElement);

            // 解析CSV数据
            let data = [['']];
            if (initialContent && initialContent.trim()) {
                const lines = initialContent.split('\n').filter(line => line.trim());
                data = lines.map(line => line.split(','));
            }

            // 初始化handsontable
            const hot = new Handsontable(container, {
                data: data,
                rowHeaders: true,
                colHeaders: true,
                height: '100%',
                width: '100%',
                licenseKey: 'non-commercial-and-evaluation',
                stretchH: 'all',
                afterChange: function(changes, source) {
                    if (source !== 'loadData' && isYjsReady && ytext) {
                        // 转换为CSV
                        const csvData = hot.getData().map(row => row.join(',')).join('\n');
                        ydoc.transact(() => {
                            ytext.delete(0, ytext.length);
                            ytext.insert(0, csvData);
                        });
                    } else if (source !== 'loadData') {
                        // 未连接协同模式
                        if (!isDirty) {
                            isDirty = true;
                            updateSaveStatus('saving', '未保存');
                        }
                        if (saveTimer) clearTimeout(saveTimer);
                        saveTimer = setTimeout(() => autoSave(), 3000);
                    }
                }
            });

            // 为手动保存函数设置表格编辑器的值获取
            simplemde = {
                value: function(newValue) {
                    if (newValue !== undefined) {
                        // 解析CSV数据
                        if (newValue && newValue.trim()) {
                            const lines = newValue.split('\n').filter(line => line.trim());
                            const data = lines.map(line => line.split(','));
                            hot.loadData(data);
                        } else {
                            hot.loadData([['']]);
                        }
                    } else {
                        // 返回CSV格式
                        return hot.getData().map(row => row.join(',')).join('\n');
                    }
                },
                hot: hot,
                codemirror: {
                    on: function(event, callback) {
                        // handsontable不需要
                    }
                }
            };

            // 绑定表格工具栏按钮事件
            $('#addRowBtn').on('click', function() {
                hot.alter('insert_row_below');
            });

            $('#addColBtn').on('click', function() {
                hot.alter('insert_col_end');
            });

            $('#formatCsvBtn').on('click', function() {
                formatCSV();
            });

            isEditorInitialized = true;
        }

        // 清理编辑器状态
        function cleanupEditor() {
            console.log('清理编辑器状态...');

            // 清理Yjs连接
            if (provider) {
                try {
                    provider.destroy();
                    console.log('Yjs provider 已销毁');
                } catch (error) {
                    console.error('销毁 Yjs provider 失败:', error);
                }
                provider = null;
            }

            // 清理Yjs文档
            if (ydoc) {
                try {
                    ydoc.destroy();
                    console.log('Yjs 文档已销毁');
                } catch (error) {
                    console.error('销毁 Yjs 文档失败:', error);
                }
                ydoc = null;
            }

            // 重置Yjs状态
            ytext = null;
            isYjsReady = false;

            // 重置防止循环的标志
            isYjsUpdating = false;
            isEditorUpdating = false;

            // 清理编辑器
            if (simplemde) {
                try {
                    // 清理handsontable
                    if (simplemde.hot && typeof simplemde.hot.destroy === 'function') {
                        simplemde.hot.destroy();
                    }
                    // 如果是SimpleMDE实例
                    if (typeof simplemde.toTextArea === 'function') {
                        simplemde.toTextArea();
                    }
                } catch (error) {
                    console.error('清理编辑器失败:', error);
                }
                simplemde = null;
            }

            // 重置编辑器初始化标志
            isEditorInitialized = false;

            // 恢复textarea结构
            const editorContainer = document.querySelector('.editor-container');
            if (editorContainer) {
                const oldEditor = document.getElementById('editor');
                if (oldEditor) {
                    oldEditor.remove();
                }
                const textarea = document.createElement('textarea');
                textarea.id = 'editor';
                editorContainer.appendChild(textarea);
            }

            // 清理自动保存定时器
            if (saveTimer) {
                clearTimeout(saveTimer);
                saveTimer = null;
            }

            // 重置脏状态
            isDirty = false;

            console.log('编辑器状态清理完成');
        }

        // 格式化CSV
        function formatCSV() {
            if (!simplemde || !simplemde.hot) {
                return;
            }

            try {
                const hot = simplemde.hot;
                const data = hot.getData();

                // 去除空格
                const formatted = data.map(row => row.map(cell => cell.trim()));

                hot.loadData(formatted);

                // 触发保存
                if (isYjsReady && ytext) {
                    const csvData = formatted.map(row => row.join(',')).join('\n');
                    ydoc.transact(() => {
                        ytext.delete(0, ytext.length);
                        ytext.insert(0, csvData);
                    });
                } else {
                    isDirty = true;
                    updateSaveStatus('saving', '未保存');
                    if (saveTimer) clearTimeout(saveTimer);
                    saveTimer = setTimeout(() => autoSave(), 3000);
                }

                showToast('CSV格式化完成');
            } catch (error) {
                console.error('CSV格式化失败:', error);
                showToast('CSV格式化失败', true);
            }
        }

        // 加载文档内容
        function loadDocument() {
            showLoading();
            $.ajax({
                url: `/api/getDocumentContent/${creator}/${fileId}`,
                type: 'GET',
                dataType: 'json',
                success: function(response) {
                    hideLoading();
                    if (response.success) {
                        currentFile = response.file;
                        $('#fileName').val(currentFile.name);

                        // 根据文件类型设置不同的标题和徽章
                        const typeText = currentFile.type === 'document' ? '文档' : '表格';
                        document.title = `${currentFile.name} - ${typeText}编辑`;
                        $('#fileTypeBadge').text(typeText);

                        // 防止重复初始化编辑器
                        if (!isEditorInitialized) {
                            // 根据文件类型初始化不同的编辑器
                            if (currentFile.type === 'document') {
                                initDocumentEditor(currentFile.content);
                            } else if (currentFile.type === 'spreadsheet') {
                                initSpreadsheetEditor(currentFile.content);
                            }

                            // 统一初始化Yjs协同
                            initYjs(currentFile.content);
                        } else {
                            // 编辑器已初始化，直接更新内容
                            // 注意：不要同时更新编辑器和Yjs，避免循环触发
                            if (simplemde && response.file.content !== undefined) {
                                const currentContent = simplemde.value();
                                const newContent = response.file.content;

                                // 只有内容确实变化时才更新
                                if (currentContent !== newContent) {
                                    // 暂时禁用Yjs观察器，防止循环触发
                                    const wasYjsUpdating = isYjsUpdating;
                                    isYjsUpdating = true;

                                    // 直接更新编辑器内容
                                    simplemde.value(newContent);

                                    // 恢复状态
                                    setTimeout(() => {
                                        isYjsUpdating = wasYjsUpdating;
                                    }, 10);
                                }
                            }
                        }

                        showToast(`${typeText}加载成功`);
                    } else {
                        showToast(response.message || '加载失败', true);
                    }
                },
                error: function(xhr, status, error) {
                    hideLoading();
                    console.error('加载文档失败:', error);
                    showToast('加载文档失败: ' + error, true);
                }
            });
        }
        
        // 文件名编辑功能
        function initFileNameEdit() {
            const fileNameInput = $('#fileName');
            
            fileNameInput.on('focus', function() {
                $(this).addClass('editing');
            });
            
            fileNameInput.on('blur', function() {
                $(this).removeClass('editing');
                const newName = $(this).val().trim();
                if (newName !== currentFile.name) {
                    renameFile(newName);
                } else {
                    $(this).val(currentFile.name);
                }
            });
            
            fileNameInput.on('keypress', function(e) {
                if (e.which === 13) {
                    $(this).blur();
                }
            });
        }
        
        // 页面离开前提示
        window.addEventListener('beforeunload', function(e) {
            if (isDirty) {
                e.preventDefault();
                e.returnValue = '文档尚未保存，确定要离开吗？';
                return '文档尚未保存，确定要离开吗？';
            }
        });
        
        // 页面初始化
        $(document).ready(function() {
            // 检查参数
            if (!fileId || !fileType) {
                showToast('缺少必要参数', true);
                setTimeout(() => {
                    window.location.href = '/codrive';
                }, 2000);
                return;
            }

            if (fileType !== 'document' && fileType !== 'spreadsheet') {
                showToast('只支持编辑文档和表格类型文件', true);
                setTimeout(() => {
                    window.location.href = '/codrive';
                }, 2000);
                return;
            }

            // 初始化
            initFileNameEdit();
            loadDocument();

            // 保存按钮
            $('#saveBtn').on('click', function() {
                manualSave();
            });

            // 版本历史按钮
            $('#versionsBtn').on('click', function() {
                $('#versionsModal').modal('show');
                loadFileVersions();
            });

            // 协同面板折叠/展开
            $('#collabHeader').on('click', toggleCollabPanel);
        });

        // WebSocket连接辅助函数
        function getWebSocketUrl() {
            const protocol = 'ws:';
            const host = window.location.hostname;
            const port = 8082;

            // 如果是本地开发，支持自定义服务器地址
            const wsHost = localStorage.getItem('websocketHost') || host;

            return `${protocol}//${wsHost}:${port}`;
        }

        function updateConnectionStatus(status) {
            const statusElement = document.getElementById('connectionStatus');
            if (statusElement) {
                statusElement.className = `connection-status ${status}`;
                statusElement.textContent = getConnectionStatusText(status);
            }
        }

        function getConnectionStatusText(status) {
            const statusMap = {
                'connected': '已连接',
                'connecting': '连接中...',
                'disconnected': '已断开',
                'synced': '已同步'
            };
            return statusMap[status] || '未知状态';
        }

        function getUserColor(userId) {
            const colors = ['#FF6B6B', '#4ECDC4', '#45B7D1', '#96CEB4', '#FECA57', '#48C9B0', '#5DADE2'];
            let hash = 0;
            for (let i = 0; i < userId.length; i++) {
                hash = userId.charCodeAt(i) + ((hash << 5) - hash);
            }
            return colors[Math.abs(hash) % colors.length];
        }

        function connectWebSocket() {
            // 清理之前的连接
            if (provider) {
                provider.destroy();
            }

            if (reconnectTimer) {
                clearTimeout(reconnectTimer);
                reconnectTimer = null;
            }

            // 重新初始化Yjs
            initYjs('');
        }
    </script>
</body>
</html>