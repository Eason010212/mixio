    // 创建新文件
    function createNewFile() {
        let fileName = $('#newFileName').val().trim();
        
        if (!fileName) {
            showToast(i18n('enterFileName'), true);
            return;
        }
        
        // 添加扩展名
        let fullFileName = '';
        let content = '';
        let contentType = '';

        if (pendingCreateType === 'document') {
            if (!fileName.endsWith('.md')) {
                fullFileName = fileName + '.md';
            } else {
                fullFileName = fileName;
            }
            content = ''; // 空文档
            contentType = 'text/markdown';
        } else if (pendingCreateType === 'spreadsheet') {
            if (!fileName.endsWith('.csv')) {
                fullFileName = fileName + '.csv';
            } else {
                fullFileName = fileName;
            }
            content = 'A,B,C,D,E\n,,,,'; // 空表格
            contentType = 'text/csv';
        } else {
            return;
        }

        showLoading();

        // 将内容转换为 Blob
        const blob = new Blob([content], { type: contentType });
        
        const formData = new FormData();
        formData.append('file', blob, fullFileName);
        
        $.ajax({
            url: '/uploadFile',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            dataType: 'json',
            success: function(response) {
                hideLoading();
                $('#newFileModal').modal('hide');
                if (response.success) {
                    showToast(i18n('fileCreated', { type: getTypeDisplayName(pendingCreateType), name: fullFileName }));
                    loadFileList();
                    // 不自动跳转编辑
                } else {
                    showToast(response.message || i18n('createFileFailed'), true);
                }
            },
            error: function(xhr, status, error) {
                hideLoading();
                console.error('创建文件失败:', error);
                showToast(i18n('createFileRetry'), true);
            }
        });
    }
    
    
    // 导入文件（上传到后端）
    function importFiles(fileInputEvent) {
        const file = fileInputEvent.target.files[0];
        if(!file) return;

        const ext = file.name.split('.').pop().toLowerCase();

        // 检查是否为图片文件
        const imageExtensions = ['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp', 'svg'];
        const isImage = imageExtensions.includes(ext);

        if (ext === 'xls' || ext === 'xlsx') {
            // Excel 文件：先转为 CSV 再上传
            showLoading();
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });
                    const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
                    const csvContent = XLSX.utils.sheet_to_csv(firstSheet);
                    const csvName = file.name.replace(/\.(xls|xlsx)$/i, '.csv');
                    const blob = new Blob(['\uFEFF' + csvContent], { type: 'text/csv;charset=utf-8' });

                    const formData = new FormData();
                    formData.append('file', blob, csvName);

                    $.ajax({
                        url: '/uploadFile',
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        dataType: 'json',
                        success: function(response) {
                            hideLoading();
                            if (response.success) {
                                showToast(i18n('convertedAndUploaded', { name: csvName }));
                                loadFileList();
                            } else {
                                showToast(response.message || i18n('uploadFailed'), true);
                            }
                        },
                        error: function(xhr, status, error) {
                            hideLoading();
                            showToast(i18n('fileUploadFailed'), true);
                        }
                    });
                } catch (err) {
                    hideLoading();
                    console.error('Excel 转换失败:', err);
                    showToast(i18n('excelConversionFailed'), true);
                }
            };
            reader.readAsArrayBuffer(file);
        } else if (ext === 'docx') {
            // DOCX 文件：转换为 Markdown 再上传
            showLoading();
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    mammoth.convertToMarkdown({ arrayBuffer: e.target.result })
                        .then(function(result) {
                            const markdownContent = result.value;
                            const mdName = file.name.replace(/\.docx$/i, '.md');
                            const blob = new Blob([markdownContent], { type: 'text/markdown;charset=utf-8' });

                            const formData = new FormData();
                            formData.append('file', blob, mdName);

                            $.ajax({
                                url: '/uploadFile',
                                type: 'POST',
                                data: formData,
                                processData: false,
                                contentType: false,
                                dataType: 'json',
                                success: function(response) {
                                    hideLoading();
                                    if (response.success) {
                                        showToast(i18n('convertedAndUploaded', { name: mdName }));
                                        loadFileList();
                                    } else {
                                        showToast(response.message || i18n('uploadFailed'), true);
                                    }
                                },
                                error: function(xhr, status, error) {
                                    hideLoading();
                                    showToast(i18n('fileUploadFailed'), true);
                                }
                            });
                        })
                        .catch(function(err) {
                            hideLoading();
                            console.error('DOCX 转换失败:', err);
                            showToast(i18n('docxConversionFailed'), true);
                        });
                } catch (err) {
                    hideLoading();
                    console.error('DOCX 读取失败:', err);
                    showToast(i18n('docxReadFailed'), true);
                }
            };
            reader.readAsArrayBuffer(file);
        } else {
            // 非 Excel 文件：直接上传
            showLoading();

            const formData = new FormData();
            formData.append('file', file);
            // 如果是图片文件，添加类型标记
            if (isImage) {
                formData.append('type', 'image');
            }

            $.ajax({
                url: '/uploadFile',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                success: function(response) {
                    hideLoading();
                    if (response.success) {
                        const fileTypeName = isImage ? i18n('image') : i18n('file');
                        showToast(i18n('uploadSuccess', { name: file.name, type: fileTypeName }));
                        loadFileList();
                    } else {
                        showToast(response.message || i18n('uploadFailed'), true);
                    }
                },
                error: function(xhr, status, error) {
                    hideLoading();
                    console.error('文件上传失败:', error);
                    let errorMsg = i18n('fileUploadFailed');
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    }
                    showToast(errorMsg, true);
                }
            });
        }

        $('#importFileInput').val('');
    }
    
    // 页面初始化
    $(document).ready(function() {
        // 加载文件列表
        loadFileList();
        
        // 新建文件下拉选项
        $('.dropdown-item[data-type]').on('click', function(e) {
            e.preventDefault();
            const type = $(this).data('type');
            showNewFileDialog(type);
        });
        
        // 确认创建按钮
        $('#confirmCreateBtn').on('click', createNewFile);
        
        // 导入文件按钮
        $('#importFileBtn').on('click', function() { 
            $('#importFileInput').click(); 
        });
        $('#importFileInput').on('change', importFiles);
        
        // 删除确认
        $('#confirmDeleteBtn').on('click', executeDelete);
        
        // 回车键确认创建
        $('#newFileName').on('keypress', function(e) {
            if (e.which === 13) {
                createNewFile();
            }
        });
    });
</script>
</body>
</html>
