<!-- 轻提示 -->
<div id="toastMsg" class="toast-notify"></div>

<script>
    let pendingDeleteId = null;
    let pendingCreateType = null;
    
    // API 基础路径
    const API_BASE = window.location.origin;
    
    // 显示加载中
    function showLoading() {
        $('#loadingOverlay').show();
    }
    
    function hideLoading() {
        $('#loadingOverlay').hide();
    }
    
    // 显示提示消息
    function showToast(msg, isError = false) {
        const toast = $('#toastMsg');
        toast.text(msg).css('opacity', '1');
        if (isError) {
            toast.css('background', '#e74a3b');
        } else {
            toast.css('background', '#2c3e50');
        }
        setTimeout(() => { 
            toast.css('opacity', '0');
            toast.css('background', '#2c3e50');
        }, 3000);
    }
    
    // 获取文件类型样式类
    function getTypeClass(type) {
        if(type === 'document') return 'type-document';
        if(type === 'spreadsheet') return 'type-spreadsheet';
        if(type === 'image') return 'type-image';
        return 'type-document';
    }
    
    // 获取文件类型显示名称
    function getTypeDisplayName(type) {
        if(type === 'document') return i18n('document');
        if(type === 'spreadsheet') return i18n('spreadsheet');
        if(type === 'image') return i18n('image');
        return i18n('file');
    }
    
    // 获取文件图标
    function getFileIcon(type) {
        if(type === 'document') return 'fa-file';
        if(type === 'spreadsheet') return 'fa-table';
        if(type === 'image') return 'fa-image';
        return 'fa-file';
    }
    
    // 格式化日期
    function formatDate(iso) {
        if(!iso) return i18n('unknown');
        const d = new Date(iso);
        return `${d.getFullYear()}-${(d.getMonth()+1).toString().padStart(2,'0')}-${d.getDate().toString().padStart(2,'0')} ${d.getHours().toString().padStart(2,'0')}:${d.getMinutes().toString().padStart(2,'0')}`;
    }
    
    // 格式化文件大小
    function formatSize(bytes) {
        if(!bytes) return '--';
        if(bytes < 1024) return bytes + ' B';
        if(bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }
    
    // HTML转义
    function escapeHtml(str) {
        if(!str) return '';
        return str.replace(/[&<>]/g, function(m) {
            if(m === '&') return '&amp;';
            if(m === '<') return '&lt;';
            if(m === '>') return '&gt;';
            return m;
        });
    }
    
    // 触发编辑跳转
    const currentUser = '<%= userName %>';
    
    // 然后在 JavaScript 函数中使用
    function triggerEditJump(fileId, fileName, fileType) {
        window.location.href = `/editFile/${currentUser}/${fileId}?type=${fileType}&name=${encodeURIComponent(fileName)}`;
    }
    
    // 下载文件
    function downloadFile(fileId, fileName, fileType) {
        // 如果是表格文件，下载时转换为 xlsx 格式
        if (fileType === 'spreadsheet') {
            showLoading();
            $.ajax({
                url: `/api/getFileContent/${fileId}`,
                type: 'GET',
                dataType: 'json',
                success: function(response) {
                    hideLoading();
                    if (response.success) {
                        try {
                            // 使用 XLSX 库将 CSV 转换为 XLSX 并下载
                            const workbook = XLSX.read(response.content, { type: 'string' });
                            const xlsxFileName = fileName.replace(/\.csv$/i, '.xlsx');
                            XLSX.writeFile(workbook, xlsxFileName);
                            showToast(i18n('downloadSuccess', { name: xlsxFileName }));
                        } catch (error) {
                            console.error('转换 CSV 到 XLSX 失败:', error);
                            showToast(i18n('fileDownloadFailed'), true);
                        }
                    } else {
                        showToast(response.message || i18n('fileDownloadFailed'), true);
                    }
                },
                error: function(xhr, status, error) {
                    hideLoading();
                    console.error('下载文件失败:', error);
                    showToast(i18n('fileDownloadFailed'), true);
                }
            });
        } else if (fileType === 'document') {
            // 文档文件，转换为 docx 格式
            showLoading();
            $.ajax({
                url: `/api/getFileContent/${fileId}`,
                type: 'GET',
                dataType: 'json',
                success: function(response) {
                    hideLoading();
                    if (response.success) {
                        try {
                            // 将 Markdown 转换为 HTML
                            const htmlContent = convertMarkdownToHtml(response.content);

                            // 使用 html-docx.js 转换为 docx
                            const converted = htmlDocx.asBlob(htmlContent);
                            const docxFileName = fileName.replace(/\.(txt|md)$/i, '.docx');

                            // 创建下载链接
                            const link = document.createElement('a');
                            link.href = window.URL.createObjectURL(converted);
                            link.download = docxFileName;
                            document.body.appendChild(link);
                            link.click();
                            document.body.removeChild(link);

                            showToast(i18n('downloadSuccess', { name: docxFileName }));
                        } catch (error) {
                            console.error('转换文档到 DOCX 失败:', error);
                            showToast(i18n('fileDownloadFailed'), true);
                        }
                    } else {
                        showToast(response.message || i18n('fileDownloadFailed'), true);
                    }
                },
                error: function(xhr, status, error) {
                    hideLoading();
                    console.error('下载文件失败:', error);
                    showToast(i18n('fileDownloadFailed'), true);
                }
            });
        } else {
            // 其他文件类型直接下载
            window.location.href = `/downloadFile/${fileId}`;
        }
    }

    // 将 Markdown 转换为 HTML（基础格式支持）
    function convertMarkdownToHtml(markdown) {
        if (!markdown) return '';

        let html = markdown;

        // 保护 HTML 标签，避免被转义（如编辑器插入的颜色 span 等）
        const htmlTags = [];
        html = html.replace(/<\/?[a-zA-Z][a-zA-Z0-9]*(\s[^>]*)?\/?>/g, function(match) {
            htmlTags.push(match);
            return `%%HTMLTAG_${htmlTags.length - 1}%%`;
        });

        // 转义 HTML 特殊字符
        html = html
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');

        // 恢复 HTML 标签
        html = html.replace(/%%HTMLTAG_(\d+)%%/g, function(match, index) {
            return htmlTags[parseInt(index)];
        });

        // 处理表格（需要在其他转换之前处理）
        html = html.replace(/((?:[^\n]*\|[^\n]*(?:\n|$))+)/g, function(match) {
            return convertMarkdownTableToHtml(match);
        });

        // 处理代码块（```code```）
        html = html.replace(/```(\w*)\n([\s\S]*?)```/g, function(match, lang, code) {
            return `<pre><code>${code.trim()}</code></pre>`;
        });

        // 处理行内代码（`code`）
        html = html.replace(/`([^`]+)`/g, '<code>$1</code>');

        // 处理标题（# ### ******）
        html = html.replace(/^######\s+(.+)$/gm, '<h6>$1</h6>');
        html = html.replace(/^#####\s+(.+)$/gm, '<h5>$1</h5>');
        html = html.replace(/^####\s+(.+)$/gm, '<h4>$1</h4>');
        html = html.replace(/^###\s+(.+)$/gm, '<h3>$1</h3>');
        html = html.replace(/^##\s+(.+)$/gm, '<h2>$1</h2>');
        html = html.replace(/^#\s+(.+)$/gm, '<h1>$1</h1>');

        // 处理粗体（**text**）
        html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');

        // 处理斜体（*text*）
        html = html.replace(/\*([^*]+)\*/g, '<em>$1</em>');

        // 处理删除线（~~text~~）
        html = html.replace(/~~([^~]+)~~/g, '<del>$1</del>');

        // 处理图片（![alt](url)）- 转换为完整服务器链接（必须在链接之前处理）
        const serverUrl = window.location.origin;
        html = html.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, function(match, alt, url) {
            // 如果是相对路径（以 / 开头），转换为完整服务器链接
            if (url.startsWith('/') && !url.startsWith('//')) {
                const fullUrl = serverUrl + url;
                return `<img src="${fullUrl}" alt="${alt}">`;
            }
            // 如果是相对路径但不是以 / 开头
            if (!url.startsWith('http') && !url.startsWith('//')) {
                const fullUrl = serverUrl + '/' + url;
                return `<img src="${fullUrl}" alt="${alt}">`;
            }
            // 完整链接或 // 协议相对链接，保持不变
            return `<img src="${url}" alt="${alt}">`;
        });

        // 处理链接（[text](url)）- 必须在图片之后处理
        html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');

        // 处理无序列表（- item 或 * item）
        html = html.replace(/^[\s]*[-*]\s+(.+)$/gm, '<li>$1</li>');
        html = html.replace(/(<li>.*<\/li>)\n(?!<li>)/g, '$1</ul>\n');
        html = html.replace(/(?<!<\/ul>\n)(<li>)/g, '<ul>$1');

        // 处理有序列表（1. item）
        html = html.replace(/^[\s]*\d+\.\s+(.+)$/gm, '<ol>$1</ol>');

        // 处理引用（> text）
        html = html.replace(/^>\s+(.+)$/gm, '<blockquote>$1</blockquote>');

        // 处理分割线（---）
        html = html.replace(/^---$/gm, '<hr>');

        // 保护块级元素，避免内部换行符被错误转换
        const protectedBlocks = [];
        html = html.replace(/<(pre|table|ul|ol|blockquote)\b[^>]*>[\s\S]*?<\/\1>/g, function(match) {
            protectedBlocks.push(match);
            return '\n%%BLOCK_' + (protectedBlocks.length - 1) + '%%\n';
        });

        // 处理段落和换行
        html = html.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
        html = html.replace(/\n\n+/g, '</p><p>');
        html = html.replace(/\n/g, '<br>');
        html = '<p>' + html + '</p>';

        // 清理空段落
        html = html.replace(/<p>\s*<\/p>/g, '');

        // 清理标题、水平线等块级元素周围多余的 <p> 包裹
        html = html.replace(/<p>\s*(<h[1-6]>)/g, '$1');
        html = html.replace(/(<\/h[1-6]>)\s*<\/p>/g, '$1');
        html = html.replace(/<p>\s*(<hr>)/g, '$1');
        html = html.replace(/(<hr>)\s*<\/p>/g, '$1');

        // 清理块级元素占位符周围多余的 <p> 包裹
        html = html.replace(/<p>\s*%%BLOCK/g, '%%BLOCK');
        html = html.replace(/%%BLOCK_\d+%%\s*<\/p>/g, function(match) {
            return match.replace(/\s*<\/p>/, '');
        });

        // 恢复块级元素
        html = html.replace(/%%BLOCK_(\d+)%%/g, function(match, index) {
            return protectedBlocks[parseInt(index)];
        });

        // 包装成完整的 HTML 文档
        return `<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; margin: 20px; }
        h1, h2, h3, h4, h5, h6 { color: #333; margin-top: 20px; }
        code { background: #f4f4f4; padding: 2px 4px; border-radius: 3px; }
        pre { background: #f4f4f4; padding: 10px; border-radius: 5px; overflow-x: auto; }
        pre code { background: none; padding: 0; }
        blockquote { border-left: 4px solid #ddd; margin: 10px 0; padding-left: 10px; color: #666; }
        hr { border: none; border-top: 2px solid #eee; margin: 20px 0; }
        img { max-width: 100%; height: auto; }
        ul, ol { margin: 10px 0; padding-left: 20px; }
        li { margin: 5px 0; }
        table { border-collapse: collapse; width: 100%; margin: 20px 0; }
        th, td { border: 1px solid #ddd; padding: 8px 12px; text-align: left; }
        th { background-color: #f8f9fa; font-weight: bold; }
        tr:nth-child(even) { background-color: #f8f9fa; }
        tr:hover { background-color: #e9ecef; }
    </style>
</head>
<body>
    ${html}
</body>
</html>`;
    }

    // 将 Markdown 表格转换为 HTML 表格
    function convertMarkdownTableToHtml(tableMarkdown) {
        const rows = tableMarkdown.trim().split('\n').filter(row => row.trim() !== '');

        if (rows.length < 2) return tableMarkdown; // 至少需要表头和分隔行

        const headerRow = rows[0];
        const separatorRow = rows[1];
        const dataRows = rows.slice(2);

        // 检查是否是有效的表格分隔行
        if (!/^[\s|:-]+$/.test(separatorRow.trim()) || !separatorRow.includes('-')) return tableMarkdown;

        // 解析表头
        const headers = parseTableRow(headerRow);

        // 解析数据行
        const data = dataRows.map(row => parseTableRow(row));

        // 构建 HTML 表格
        let html = '<table>\n';

        // 表头
        html += '  <thead>\n    <tr>\n';
        headers.forEach(header => {
            html += `      <th>${header}</th>\n`;
        });
        html += '    </tr>\n  </thead>\n';

        // 表体
        html += '  <tbody>\n';
        data.forEach(row => {
            html += '    <tr>\n';
            row.forEach(cell => {
                html += `      <td>${cell}</td>\n`;
            });
            html += '    </tr>\n';
        });
        html += '  </tbody>\n';

        html += '</table>\n';

        return html;
    }

    // 解析表格行
    function parseTableRow(row) {
        // 移除首尾的 |
        let cleanedRow = row.trim();
        if (cleanedRow.startsWith('|')) {
            cleanedRow = cleanedRow.substring(1);
        }
        if (cleanedRow.endsWith('|')) {
            cleanedRow = cleanedRow.substring(0, cleanedRow.length - 1);
        }

        // 分割单元格，处理包含 | 的内容
        const cells = [];
        let currentCell = '';
        let inVerticalBar = false;

        for (let i = 0; i < cleanedRow.length; i++) {
            const char = cleanedRow[i];
            if (char === '|' && !inVerticalBar) {
                cells.push(currentCell.trim());
                currentCell = '';
            } else if (char === '\\') {
                inVerticalBar = true;
            } else {
                currentCell += char;
                inVerticalBar = false;
            }
        }

        if (currentCell.trim()) {
            cells.push(currentCell.trim());
        }

        return cells;
    }
    
    // 从后端加载文件列表
    function loadFileList() {
        showLoading();
        $.ajax({
            url: '/getFileList',
            type: 'GET',
            dataType: 'json',
            success: function(response) {
                hideLoading();
                if (response.success) {
                    renderFileList(response.files || [], response.sharedLinks || []);
                } else {
                    showToast(response.message || i18n('loadFileListFailed'), true);
                    renderFileList([], []);
                }
            },
            error: function(xhr, status, error) {
                hideLoading();
                console.error('加载文件列表失败:', error);
                showToast(i18n('loadFileListNetworkFailed'), true);
                renderFileList([], []);
            }
        });
    }
    
