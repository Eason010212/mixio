        const shareUrl = `${window.location.origin}/editFile/${currentUser}/${fileId}?type=${fileType}&name=${encodeURIComponent(fileName)}`;
        
        // 创建模态框
        const modalHtml = `
            <div class="modal fade" id="shareLinkModal" tabindex="-1" role="dialog" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                <i class="fa fa-share-alt" style="color: #f57c00;"></i> ${i18n('shareLink')}
                            </h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <p>${i18n('shareLinkHelp', { name: escapeHtml(fileName) })}</p>
                            <div class="input-group mb-3">
                                <input type="text" class="form-control" id="shareUrlInput" value="${shareUrl}" readonly>
                                <div class="input-group-append">
                                    <button class="btn btn-primary" id="copyShareUrlBtn" type="button">
                                        <i class="fa fa-copy"></i> ${i18n('copy')}
                                    </button>
                                </div>
                            </div>
                            <div class="alert alert-info small mt-2">
                                <i class="fa fa-info-circle"></i> 
                                ${i18n('anyoneCanEdit')}
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">${i18n('close')}</button>
                        </div>
                    </div>
                </div>
            </div>
        `;
        
        // 移除已存在的模态框
        if ($('#shareLinkModal').length) {
            $('#shareLinkModal').remove();
        }
        
        // 添加模态框到页面
        $('body').append(modalHtml);
        
        // 显示模态框
        $('#shareLinkModal').modal('show');
        
        // 自动选中输入框内容
        $('#shareLinkModal').on('shown.bs.modal', function() {
            $('#shareUrlInput').focus().select();
        });
        
        // 复制按钮事件
        $('#copyShareUrlBtn').off('click').on('click', function() {
            const urlInput = $('#shareUrlInput');
            urlInput.select();
            urlInput[0].setSelectionRange(0, 99999);
            
            navigator.clipboard.writeText(shareUrl).then(() => {
                // 显示复制成功提示
                const copyBtn = $(this);
                const originalHtml = copyBtn.html();
                copyBtn.html('<i class="fa fa-check"></i> ' + i18n('copied'));
                setTimeout(() => {
                    copyBtn.html(originalHtml);
                }, 2000);
                
                // 同时显示 toast 提示
                showToast(i18n('copiedToClipboard'));
            }).catch(err => {
                console.error('复制失败:', err);
                // 降级方案
                document.execCommand('copy');
                showToast(i18n('copied'), true);
            });
        });
        
        // 点击输入框自动全选
        $('#shareUrlInput').off('click').on('click', function() {
            $(this).select();
        });
    }

