    </div>
</div>

<!-- 删除确认模态框 -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">确认删除</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>确定要删除文件 <strong id="deleteFileName"></strong> 吗？</p>
                <p class="text-muted small">此操作不可撤销</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">取消</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">确认删除</button>
            </div>
        </div>
    </div>
</div>

<!-- 加载遮罩 -->
<div class="loading-overlay" id="loadingOverlay">
    <div class="loading-spinner">
        <i class="fa fa-spinner fa-spin fa-2x"></i>
        <p class="mt-2">处理中...</p>
    </div>
</div>

<!-- 轻提示 -->
<div id="toastMsg" class="toast-notify"></div>

<script>
    let pendingDeleteId = null;
    let pendingCreateType = null;
    
    // API 基础路径
    const API_BASE = window.location.origin;
    
    // 显示加载中
    function showLoading() {
        $('#loadingOverlay').show();
    }
    
    function hideLoading() {
        $('#loadingOverlay').hide();
    }
    
    // 显示提示消息
    function showToast(msg, isError = false) {
        const toast = $('#toastMsg');
        toast.text(msg).css('opacity', '1');
        if (isError) {
            toast.css('background', '#e74a3b');
        } else {
            toast.css('background', '#2c3e50');
        }
        setTimeout(() => { 
            toast.css('opacity', '0');
            toast.css('background', '#2c3e50');
        }, 3000);
    }
    
    // 获取文件类型样式类
    function getTypeClass(type) {
        if(type === 'document') return 'type-document';
        if(type === 'spreadsheet') return 'type-spreadsheet';
        return 'type-document';
    }
    
    // 获取文件类型显示名称
    function getTypeDisplayName(type) {
        if(type === 'document') return '文档';
        if(type === 'spreadsheet') return '表格';
        return '文件';
    }
    
    // 获取文件图标
    function getFileIcon(type) {
        if(type === 'document') return 'fa-file';
        if(type === 'spreadsheet') return 'fa-table';
        return 'fa-file';
    }
    
    // 格式化日期
    function formatDate(iso) {
        if(!iso) return '未知';
        const d = new Date(iso);
        return `${d.getFullYear()}-${(d.getMonth()+1).toString().padStart(2,'0')}-${d.getDate().toString().padStart(2,'0')} ${d.getHours().toString().padStart(2,'0')}:${d.getMinutes().toString().padStart(2,'0')}`;
    }
    
    // 格式化文件大小
    function formatSize(bytes) {
        if(!bytes) return '--';
        if(bytes < 1024) return bytes + ' B';
        if(bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }
    
    // HTML转义
    function escapeHtml(str) {
        if(!str) return '';
        return str.replace(/[&<>]/g, function(m) {
            if(m === '&') return '&amp;';
            if(m === '<') return '&lt;';
            if(m === '>') return '&gt;';
            return m;
        });
    }
    
    // 触发编辑跳转
    const currentUser = '<%= userName %>';
    
    // 然后在 JavaScript 函数中使用
    function triggerEditJump(fileId, fileName, fileType) {
        window.location.href = `/editFile/${currentUser}/${fileId}?type=${fileType}&name=${encodeURIComponent(fileName)}`;
    }
    
    // 下载文件
    function downloadFile(fileId, fileName) {
        window.location.href = `/downloadFile/${fileId}`;
    }
    
    // 从后端加载文件列表
    function loadFileList() {
        showLoading();
        $.ajax({
            url: '/getFileList',
            type: 'GET',
            dataType: 'json',
            success: function(response) {
                hideLoading();
                if (response.success) {
                    renderFileList(response.files || []);
                } else {
                    showToast(response.message || '加载文件列表失败', true);
                    renderFileList([]);
                }
            },
            error: function(xhr, status, error) {
                hideLoading();
                console.error('加载文件列表失败:', error);
                showToast('加载文件列表失败，请检查网络连接', true);
                renderFileList([]);
            }
        });
    }
    
    // 渲染列表视图
    function renderFileList(files) {
        const container = $('#fileListContainer');
        if(!files || files.length === 0) {
            container.html(`
                <div class="empty-placeholder">
                    <i class="fa fa-cloud-upload-alt fa-3x text-gray-300 mb-3"></i>
                    <h5 class="text-gray-500">暂无文件</h5>
                    <p class="text-muted small">点击"新建文件"或"导入文件"开始使用协同云盘</p>
                </div>
            `);
            return;
        }
        
        let html = `
            <table class="file-table">
                <thead>
                    <tr>
                        <th style="width: 35%">文件名</th>
                        <th style="width: 12%">类型</th>
                        <th style="width: 20%">修改时间</th>
                        <th style="width: 10%">大小</th>
                        <th style="width: 23%">操作</th>
                    </tr>
                </thead>
                <tbody>
        `;
        
        files.forEach(file => {
            const typeClass = getTypeClass(file.type);
            const typeName = getTypeDisplayName(file.type);
            const iconClass = getFileIcon(file.type);
            const sizeStr = formatSize(file.size);
            // 在 renderFileList 函数中，找到 action-buttons div，添加复制按钮
            html += `
                <tr class="file-row" data-id="${file.id}" data-type="${file.type}" data-name="${escapeHtml(file.name)}">
                    <td class="file-name-cell">
                        <i class="fa ${iconClass}"></i>
                        <span>${escapeHtml(file.name)}</span>
                    </td>
                    <td>
                        <span class="type-badge ${typeClass}">${typeName}</span>
                    </td>
                    <td class="text-muted small">${formatDate(file.uploadTime || file.updatedAt)}</td>
                    <td class="text-muted small">${sizeStr}</td>
                    <td>
                        <div class="action-buttons">
                            <button class="action-btn btn-edit-link edit-btn" data-id="${file.id}" data-name="${escapeHtml(file.name)}" data-type="${file.type}">
                                编辑
                            </button>
                            <button class="action-btn btn-download download-btn" data-id="${file.id}" data-name="${escapeHtml(file.name)}">
                                下载
                            </button>
                            <button class="action-btn btn-copy copy-btn" data-id="${file.id}" data-name="${escapeHtml(file.name)}" data-type="${file.type}" style="background: #fff3e0; color: #f57c00;">
                                分享
                            </button>
                            <button class="action-btn btn-delete delete-btn" data-id="${file.id}" data-name="${escapeHtml(file.name)}">
                                删除
                            </button>
                        </div>
                    </td>
                </tr>
            `;})
        
        html += `</tbody></table>`;
        container.html(html);
        
        // 绑定行点击事件（整行点击触发编辑）
        $('.file-row').off('click').on('click', function(e) {
            if($(e.target).closest('.action-buttons').length) return;
            const fileId = $(this).data('id');
            const fileName = $(this).data('name');
            const fileType = $(this).data('type');
            triggerEditJump(fileId, fileName, fileType);
        });
        $('.copy-btn').off('click').on('click', function(e) {
            e.stopPropagation();
            const fileId = $(this).data('id');
            const fileName = $(this).data('name');
            const fileType = $(this).data('type');
            copyShareLink(fileId, fileName, fileType);
        });
        // 绑定编辑按钮事件
        $('.edit-btn').off('click').on('click', function(e) {
            e.stopPropagation();
            const fileId = $(this).data('id');
            const fileName = $(this).data('name');
            const fileType = $(this).data('type');
            triggerEditJump(fileId, fileName, fileType);
        });
        
        // 绑定下载按钮事件
        $('.download-btn').off('click').on('click', function(e) {
            e.stopPropagation();
            const fileId = $(this).data('id');
            const fileName = $(this).data('name');
            downloadFile(fileId, fileName);
        });
        
        // 绑定删除按钮事件
        $('.delete-btn').off('click').on('click', function(e) {
            e.stopPropagation();
            const fileId = $(this).data('id');
            const fileName = $(this).data('name');
            showDeleteConfirm(fileId, fileName);
        });
    }
    
    // 显示删除确认弹窗
    function showDeleteConfirm(fileId, fileName) {
        pendingDeleteId = fileId;
        $('#deleteFileName').text(fileName);
        $('#deleteConfirmModal').modal('show');
    }

    // 复制分享链接
    // 显示链接分享对话框
    function showShareDialog(fileId, fileName, fileType) {
        const shareUrl = `${window.location.origin}/editFile/${currentUser}/${fileId}?type=${fileType}&name=${encodeURIComponent(fileName)}`;
        
        // 创建模态框
        const modalHtml = `
            <div class="modal fade" id="shareLinkModal" tabindex="-1" role="dialog" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                <i class="fa fa-share-alt" style="color: #f57c00;"></i> 分享链接
                            </h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <p>分享以下链接给他人，即可协同编辑文档 <strong>${escapeHtml(fileName)}</strong></p>
                            <div class="input-group mb-3">
                                <input type="text" class="form-control" id="shareUrlInput" value="${shareUrl}" readonly>
                                <div class="input-group-append">
                                    <button class="btn btn-primary" id="copyShareUrlBtn" type="button">
                                        <i class="fa fa-copy"></i> 复制
                                    </button>
                                </div>
                            </div>
                            <div class="alert alert-info small mt-2">
                                <i class="fa fa-info-circle"></i> 
                                任何人拥有此链接都可以查看和编辑文档
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">关闭</button>
                        </div>
                    </div>
                </div>
            </div>
        `;
        
        // 移除已存在的模态框
        if ($('#shareLinkModal').length) {
            $('#shareLinkModal').remove();
        }
        
        // 添加模态框到页面
        $('body').append(modalHtml);
        
        // 显示模态框
        $('#shareLinkModal').modal('show');
        
        // 自动选中输入框内容
        $('#shareLinkModal').on('shown.bs.modal', function() {
            $('#shareUrlInput').focus().select();
        });
        
        // 复制按钮事件
        $('#copyShareUrlBtn').off('click').on('click', function() {
            const urlInput = $('#shareUrlInput');
            urlInput.select();
            urlInput[0].setSelectionRange(0, 99999);
            
            navigator.clipboard.writeText(shareUrl).then(() => {
                // 显示复制成功提示
                const copyBtn = $(this);
                const originalHtml = copyBtn.html();
                copyBtn.html('<i class="fa fa-check"></i> 已复制');
                setTimeout(() => {
                    copyBtn.html(originalHtml);
                }, 2000);
                
                // 同时显示 toast 提示
                showToast('链接已复制到剪贴板');
            }).catch(err => {
                console.error('复制失败:', err);
                // 降级方案
                document.execCommand('copy');
                showToast('链接已复制', true);
            });
        });
        
        // 点击输入框自动全选
        $('#shareUrlInput').off('click').on('click', function() {
            $(this).select();
        });
    }

    // 复制分享链接（改为显示对话框）
    function copyShareLink(fileId, fileName, fileType) {
        showShareDialog(fileId, fileName, fileType);
    }

    
    // 执行删除
    function executeDelete() {
        if(!pendingDeleteId) return;
        
        showLoading();
        $.ajax({
            url: `/deleteFile/${pendingDeleteId}`,
            type: 'DELETE',
            dataType: 'json',
            success: function(response) {
                hideLoading();
                if (response.success) {
                    showToast('文件删除成功');
                    loadFileList();
                } else {
                    showToast(response.message || '删除失败', true);
                }
            },
            error: function(xhr, status, error) {
                hideLoading();
                console.error('删除文件失败:', error);
                showToast('删除文件失败，请稍后重试', true);
            }
        });
        
        pendingDeleteId = null;
        $('#deleteConfirmModal').modal('hide');
    }
    
    // 显示新建文件对话框
    function showNewFileDialog(type) {
        pendingCreateType = type;
        let title = '';
        let extension = '';
        let hint = '';

        if(type === 'document') {
            title = '新建文档';
            extension = '.md';
            hint = '文件名将自动添加 .md 扩展名';
        } else if(type === 'spreadsheet') {
            title = '新建表格';
            extension = '.csv';
            hint = '文件中将自动添加 .csv 扩展名';
        }

        $('#newFileModalTitle').text(title);
        $('#extensionHint').text(hint);
        $('#newFileName').val('');
        $('#newFileModal').modal('show');
    }
    
    // 创建新文件
    function createNewFile() {
        let fileName = $('#newFileName').val().trim();
        
        if (!fileName) {
            showToast('请输入文件名', true);
            return;
        }
        
        // 添加扩展名
        let fullFileName = '';
        let content = '';
        let contentType = '';

        if (pendingCreateType === 'document') {
            if (!fileName.endsWith('.md')) {
                fullFileName = fileName + '.md';
            } else {
                fullFileName = fileName;
            }
            content = ''; // 空文档
            contentType = 'text/markdown';
        } else if (pendingCreateType === 'spreadsheet') {
            if (!fileName.endsWith('.csv')) {
                fullFileName = fileName + '.csv';
            } else {
                fullFileName = fileName;
            }
            content = ''; // 空表格
            contentType = 'text/csv';
        } else {
            return;
        }

        showLoading();

        // 将内容转换为 Blob
        const blob = new Blob([content], { type: contentType });
        
        const formData = new FormData();
        formData.append('file', blob, fullFileName);
        
        $.ajax({
            url: '/uploadFile',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            dataType: 'json',
            success: function(response) {
                hideLoading();
                $('#newFileModal').modal('hide');
                if (response.success) {
                    showToast(`已创建${getTypeDisplayName(pendingCreateType)}: ${fullFileName}`);
                    loadFileList();
                    // 不自动跳转编辑
                } else {
                    showToast(response.message || '创建文件失败', true);
                }
            },
            error: function(xhr, status, error) {
                hideLoading();
                console.error('创建文件失败:', error);
                showToast('创建文件失败，请稍后重试', true);
            }
        });
    }
    
    
    // 导入文件（上传到后端）
    function importFiles(fileInputEvent) {
        const file = fileInputEvent.target.files[0];
        if(!file) return;
        
        showLoading();
        
        const formData = new FormData();
        formData.append('file', file);
        
        $.ajax({
            url: '/uploadFile',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            dataType: 'json',
            success: function(response) {
                hideLoading();
                if (response.success) {
                    showToast(`上传成功: ${file.name}`);
                    loadFileList();
                } else {
                    showToast(response.message || '上传失败', true);
                }
            },
            error: function(xhr, status, error) {
                hideLoading();
                console.error('文件上传失败:', error);
                let errorMsg = '文件上传失败';
                if (xhr.responseJSON && xhr.responseJSON.message) {
                    errorMsg = xhr.responseJSON.message;
                }
                showToast(errorMsg, true);
            }
        });
        
        $('#importFileInput').val('');
    }
    
    // 页面初始化
    $(document).ready(function() {
        // 加载文件列表
        loadFileList();
        
        // 新建文件下拉选项
        $('.dropdown-item[data-type]').on('click', function(e) {
            e.preventDefault();
            const type = $(this).data('type');
            showNewFileDialog(type);
        });
        
        // 确认创建按钮
        $('#confirmCreateBtn').on('click', createNewFile);
        
        // 导入文件按钮
        $('#importFileBtn').on('click', function() { 
            $('#importFileInput').click(); 
        });
        $('#importFileInput').on('change', importFiles);
        
        // 删除确认
        $('#confirmDeleteBtn').on('click', executeDelete);
        
        // 回车键确认创建
        $('#newFileName').on('keypress', function(e) {
            if (e.which === 13) {
                createNewFile();
            }
        });
    });
</script>
</body>
</html>