<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="MixIO CoDrive - 协同云盘，支持文档、表格管理">
    <title>MixIO</title>
    <link rel="shortcut icon" href="img/shortcut.png">
    <!-- CSS 资源 -->
    <link rel="stylesheet" href="css/all.css">
    <link rel="stylesheet" href="css/dataTables.bootstrap4.min.css">
    <style>
        /* 文件管理区域 - 列表视图样式 */
        .file-manager-container {
            padding: 20px 30px;
            background: #f8f9fc;
            min-height: calc(100vh - 200px);
        }
        .action-bar {
            margin-bottom: 25px;
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #e3e6f0;
            padding-bottom: 15px;
        }
        .btn-group-custom {
            display: flex;
            gap: 12px;
        }
        .btn-icon {
            margin-right: 6px;
        }
        /* 列表视图样式 */
        .file-table-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 0.15rem 1.25rem 0 rgba(0,0,0,.05);
            overflow: hidden;
            border: 1px solid #e3e6f0;
        }
        .file-table {
            width: 100%;
            margin-bottom: 0;
        }
        .file-table th {
            background: #f8f9fc;
            border-bottom: 2px solid #e3e6f0;
            padding: 14px 16px;
            font-weight: 600;
            color: #4e73df;
            font-size: 0.85rem;
        }
        .file-table td {
            padding: 14px 16px;
            vertical-align: middle;
            border-bottom: 1px solid #eaecf4;
        }
        .file-table tr:hover {
            background: #f8f9fc;
            cursor: pointer;
        }
        .file-name-cell {
            font-weight: 500;
            color: #2c3e50;
            word-break: break-all;
        }
        .file-name-cell i {
            margin-right: 12px;
            font-size: 1.2rem;
            width: 24px;
            color: #4e73df;
        }
        .type-badge {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 500;
            display: inline-block;
        }
        .type-document {
            background: #e3f2fd;
            color: #1976d2;
        }
        .type-spreadsheet {
            background: #e8f5e9;
            color: #388e3c;
        }
        .action-buttons {
            display: flex;
            gap: 8px;
        }
        .action-btn {
            padding: 5px 12px;
            border-radius: 6px;
            font-size: 0.75rem;
            border: none;
            background: none;
            transition: 0.2s;
            cursor: pointer;
        }
        .btn-edit-link {
            background: #e8f0fe;
            color: #4e73df;
        }
        .btn-edit-link:hover {
            background: #d9e6ff;
        }
        .btn-copy {
            background: #fff3e0;
            color: #f57c00;
        }
        .btn-copy:hover {
            background: #ffe0b3;
        }
        .btn-download {
            background: #e8f5e9;
            color: #388e3c;
        }
        .btn-download:hover {
            background: #c8e6c9;
        }
        .btn-delete {
            color: #f61b08;
            background: rgb(249, 207, 203);
        }
        .empty-placeholder {
            text-align: center;
            padding: 60px 20px;
            background: white;
            border-radius: 12px;
            border: 1px dashed #cbd5e0;
        }
        .toast-notify {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: #2c3e50;
            color: white;
            padding: 10px 18px;
            border-radius: 30px;
            font-size: 0.85rem;
            z-index: 1050;
            opacity: 0;
            transition: 0.2s;
            pointer-events: none;
        }
        .import-file-input {
            display: none;
        }
        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.5);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 2000;
        }
        .loading-spinner {
            background: white;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
        }
        /* 新建文件对话框样式 */
        .modal-dialog-custom {
            max-width: 450px;
        }
        .extension-hint {
            font-size: 0.8rem;
            color: #6c757d;
            margin-top: 5px;
        }
    </style>
    <!-- 脚本资源 -->
    <script src="js/jquery.min.js"></script>
    <script src="js/lang.js"></script>
    <script src="js/bootstrap.bundle.min.js"></script>
    <script src="js/jquery.easing.min.js"></script>
    <script src="js/echarts.min.js"></script>
    <script src="js/jquery.easyui.min.js"></script>
    <script src="js/mqtt.min.js"></script>
    <script src="js/jquery.dataTables.min.js"></script>
    <script src="js/dataTables.bootstrap4.min.js"></script>
    <script src="js/tools.js"></script>
    <script src="js/sb-admin-2.min.js?v=2"></script>
</head>
