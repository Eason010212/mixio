            const creator = $(this).data('creator');
            const fileId = $(this).data('file-id');
            const fileName = $(this).data('name');
            const fileType = $(this).data('type');
            const isAvailable = $(this).data('available');
            if (!isAvailable) {
                showToast(i18n('sourceFileUnavailable'), true);
                return;
            }
            if (fileType === 'image') {
                showToast(i18n('imageOnlineEditUnsupported'), true);
                return;
            }
            window.location.href = `/editFile/${creator}/${fileId}?type=${fileType}&name=${encodeURIComponent(fileName)}`;
        });

        // 编辑共享文件按钮
        $('.edit-shared-btn').off('click').on('click', function(e) {
            e.stopPropagation();
